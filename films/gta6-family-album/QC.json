    "caption_layouts": [
      {
        "text": "یکی از افسانه‌ای‌ترین میم‌های اینترنت بالاخره مُرد!",
        "x": 94,
        "y": 1543,
        "w": 892,
        "h": 107,
        "scroll": 105,
        "client": 105
      },
      {
        "text": "فکر کنم بگم، خودت می‌فهمی منظورم چیه.",
        "x": 94,
        "y": 1543,
        "w": 892,
        "h": 107,
        "scroll": 105,
        "client": 105
      },
      {
        "text": "بریم چندتا از بهتریناشو ببینیم؛",
        "x": 94,
        "y": 1543,
        "w": 892,
        "h": 107,
        "scroll": 105,
        "client": 105
      },
      {
        "text": "آخریش دیگه واقعاً یه چیز دیگه‌ست!",
        "x": 94,
        "y": 1543,
        "w": 892,
        "h": 107,
        "scroll": 105,
        "client": 105
      },
      {
        "text": "حتی فضایی‌ها هم قبل از جی‌تی‌ای شش رسیدن!",
        "x": 94,
        "y": 1543,
        "w": 892,
        "h": 107,
        "scroll": 105,
        "client": 105
      },
      {
        "text": "حتی فضایی‌ها هم زودتر از جی‌تی‌ای شش رسیدن!",
        "x": 94,
        "y": 1543,
        "w": 892,
        "h": 107,
        "scroll": 105,
        "client": 105
      },
      {
        "text": "حتی توییتر هم قبل از جی‌تی‌ای شش، ایکس شد!",
        "x": 94,
        "y": 1543,
        "w": 892,
        "h": 107,
        "scroll": 105,
        "client": 105
      },
      {
        "text": "توییتر کلاً هویتش عوض شد!",
        "x": 94,
        "y": 1543,
        "w": 892,
        "h": 107,
        "scroll": 105,
        "client": 105
      },
      {
        "text": "مسی هم قبل از جی‌تی‌ای شش جام جهانی رو برد!",
        "x": 94,
        "y": 1543,
        "w": 892,
        "h": 107,
        "scroll": 105,
        "client": 105
      },
      {
        "text": "مسی بالاخره جام جهانی رو برد!",
        "x": 94,
        "y": 1543,
        "w": 892,
        "h": 107,
        "scroll": 105,
        "client": 105
      },
      {
        "text": "رونالدو از منچستریونایتد رفت…",
        "x": 94,
        "y": 1543,
        "w": 892,
        "h": 107,
        "scroll": 105,
        "client": 105
      },
      {
        "text": "به النصر پیوست…",
        "x": 94,
        "y": 1543,
        "w": 892,
        "h": 107,
        "scroll": 105,
        "client": 105
      },
      {
        "text": "و حتی به تهران هم اومد!",
        "x": 94,
        "y": 1543,
        "w": 892,
        "h": 107,
        "scroll": 105,
        "client": 105
      },
      {
        "text": "رونالدو تو این مدت یه زندگی کامل کرد!",
        "x": 94,
        "y": 1543,
        "w": 892,
        "h": 107,
        "scroll": 105,
        "client": 105
      },
      {
        "text": "همهٔ این‌ها قبل از جی‌تی‌ای شش!",
        "x": 94,
        "y": 1543,
        "w": 892,
        "h": 107,
        "scroll": 105,
        "client": 105
      },
      {
        "text": "حتی پاپ جدید هم قبل از جی‌تی‌ای شش اومد!",
        "x": 94,
        "y": 1543,
        "w": 892,
        "h": 107,
        "scroll": 105,
        "client": 105
      },
      {
        "text": "حتی پاپ هم عوض شد!",
        "x": 94,
        "y": 1543,
        "w": 892,
        "h": 107,
        "scroll": 105,
        "client": 105
      },
      {
        "text": "ولی آخری از همه عجیب‌تره…",
        "x": 94,
        "y": 1543,
        "w": 892,
        "h": 107,
        "scroll": 105,
        "client": 105
      },
      {
        "text": "خود جی‌تی‌ای شش هم نامزد جایزه شد…",
        "x": 94,
        "y": 1543,
        "w": 892,
        "h": 107,
        "scroll": 105,
        "client": 105
      },
      {
        "text": "قبل از اینکه جی‌تی‌ای شش بیاد!",
        "x": 94,
        "y": 1543,
        "w": 892,
        "h": 107,
        "scroll": 105,
        "client": 105
      },
      {
        "text": "یعنی خود جی‌تی‌ای شش هم قبل از جی‌تی‌ای شش",
        "x": 94,
        "y": 1472,
        "w": 892,
        "h": 178,
