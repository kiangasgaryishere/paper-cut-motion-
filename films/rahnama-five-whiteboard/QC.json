  "caption_count": 30,
  "caption_layout_preflight": {
    "caption_layouts": [
      {
        "text": "کلاس زبان ثبت‌نام نکن،",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "اگه قراره این ۵ تا چیز رو از دست بدی!",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "مخصوصاً آخری!",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "اول، فقط تعیین سطح؟",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "اینکه بگن سطحت چیه",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "و برو بشین تو فلان ترم که کاری نداره!",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "تو رهنما، براساس نیازت",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "یه نقشهٔ راه یادگیری می‌چینیم؛",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "با برنامهٔ ترمی و هفتگی مخصوص خودت.",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "دوم، همون محتوای تکراری برای همه؟",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "هر هفته محتوای مخصوص خودت رو می‌گیری؛",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "فیلم، پادکست، بازی و تمرین‌هایی",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "که برای نیازهای تو انتخاب یا طراحی شدن.",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "سوم، گرامر بخون، تمرین حل کن؟",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "اینجا گرامر رو توی بازی استفاده می‌کنی،",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "توی بحث بقیه رو قانع می‌کنی،",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "نقش بازی می‌کنی",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "و با زبان مسئله حل می‌کنی.",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "چهارم، یادگیری فقط توی کلاس؟",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "بیرون کلاس هم تمرین می‌کنی،",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "سؤال می‌پرسی",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "و روی کارهات بازخورد می‌گیری.",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "حتی می‌تونی توی یک ترم از چند مدرس یاد بگیری.",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "پنجم، این یکی رو احتمالاً نشنیدی!",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "تمرین‌ها، اشتباهات و پیشرفتت ثبت می‌شن.",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "چند نفر از تیم آموزشی با هم بررسی‌شون می‌کنن",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "تا برنامهٔ هفتهٔ بعدت دقیق‌تر طراحی بشه.",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "این چیزیه که داریم تو آکادمی رهنما اجرا می‌کنیم.",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      },
      {
        "text": "اگه می‌خوای ببینی برنامهٔ مخصوص خودت چه شکلیه،",
        "x": 94,
        "y": 1466,
        "w": 892,
        "h": 184,
        "scroll": 180,
        "client": 180
      },
      {
        "text": "کلمهٔ «برنامه» رو کامنت کن!",
        "x": 94,
        "y": 1539,
        "w": 892,
        "h": 111,
        "scroll": 107,
        "client": 107
      }
    ],
