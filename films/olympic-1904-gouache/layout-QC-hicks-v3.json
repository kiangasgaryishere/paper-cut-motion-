  "edited_captions": [
    {
      "time": 71,
      "frame": 2130,
      "text": "بخش زیادی از مسیر رو\nبا ماشین اومده!"
    },
    {
      "time": 73.3,
      "frame": 2199,
      "text": "ماجرا رو فهمیدن!"
    },
    {
      "time": 74.73333333333333,
      "frame": 2242,
      "text": "اما قهرمان واقعی\nتوماس هیکس بود!"
    },
    {
      "time": 77.13333333333334,
      "frame": 2314,
      "text": "اون‌قدر خسته و کم‌آب شده بود..."
    },
    {
      "time": 79.1,
      "frame": 2373,
      "text": "که دچار توهم شده بود!"
    },
    {
      "time": 81,
      "frame": 2430,
      "text": "با اینکه نزدیک خط پایان بود،"
    },
    {
      "time": 82.1,
      "frame": 2463,
      "text": "فکر می‌کرد هنوز ۲۰ مایل دیگه\nباید بدوه!"
    },
    {
      "time": 85.13333333333334,
      "frame": 2554,
      "text": "مربی‌ها کمکش کردن ادامه بده..."
    },
    {
      "time": 87.2,
      "frame": 2616,
      "text": "و بالاخره به خط پایان رسید\nو قهرمان شد!"
    },
    {
      "time": 90.2,
      "frame": 2706,
      "text": "کمکش کردن ادامه بده!"
    },
    {
      "time": 91.63333333333334,
      "frame": 2749,
      "text": "حالا دقت کردی؟"
    },
    {
      "time": 93.06666666666668,
      "frame": 2792,
      "text": "تمام‌شدنِ چیزی"
    },
    {
      "time": 94.63333333333334,
      "frame": 2839,
      "text": "پیداشدن"
    },
    {
      "time": 95.76666666666667,
      "frame": 2873,
      "text": "بریدن و جداکردن"
    },
    {
      "time": 96.80000000000001,
      "frame": 2904,
      "text": "درازکشیدن"
    },
    {
      "time": 98.16666666666667,
      "frame": 2945,
      "text": "کنارکشیدن"
    },
    {
      "time": 99.33333333333334,
      "frame": 2980,
      "text": "سوارکردن"
    },
    {
      "time": 100.4,
      "frame": 3012,
      "text": "خراب‌شدن"
    },
    {
      "time": 101.73333333333333,
      "frame": 3052,
      "text": "پیاده‌شدن"
    },
    {
      "time": 102.80000000000001,
      "frame": 3084,
      "text": "فهمیدن"
    },
    {
      "time": 104.03333333333333,
      "frame": 3121,
      "text": "ادامه‌دادن"
    },
    {
      "time": 105.80000000000001,
      "frame": 3174,
      "text": "این‌ها فعل‌های چندکلمه‌ای هستن."
    },
    {
      "time": 108.10000000000001,
      "frame": 3243,
      "text": "فعل‌هایی که با اضافه‌شدن\nیه کلمهٔ کوچیک..."
    },
    {
      "time": 110.53333333333333,
      "frame": 3316,
      "text": "معنی یا کاربرد تازه‌ای\nپیدا می‌کنن."
    },
    {
      "time": 113.53333333333333,
      "frame": 3406,
      "text": "اگه می‌خوای هر هفته\n۱۰ تا از این فعل‌ها رو..."
    },
    {
      "time": 115.86666666666667,
      "frame": 3476,
      "text": "با داستان، ویس و تمرین مکالمه\nیاد بگیری،"
    },
    {
      "time": 119.23333333333333,
      "frame": 3577,
      "text": "کلمهٔ «فریزال» رو کامنت کن..."
    },
    {
      "time": 120.93333333333334,
      "frame": 3628,
      "text": "تا بستهٔ هفتهٔ اول رو\nبرات بفرستیم!"
    }
  ],
