{
  "duration": 93,
  "fps": 24,
  "captions": [
    {
      "start": 0,
      "end": 3.25,
      "text": "ممکنه یه فرش کاملاً ایرانی به نظر برسه،"
    },
    {
      "start": 3.61,
      "end": 6.33,
      "text": "ولی حتی یه گره‌اش هم توی ایران زده نشده باشه!"
    },
    {
      "start": 6.79,
      "end": 8.86,
      "text": "و این فقط یه بازی با کلمات نیست؛"
    },
    {
      "start": 9.13,
      "end": 13.05,
      "text": "یه بحث جدی دربارهٔ هویت و اصالت فرش ایرانیه."
    },
    {
      "start": 14.08,
      "end": 17.07,
      "text": "فرش ایرانی برای قرن‌ها یکی از شناخته‌شده‌ترین"
    },
    {
      "start": 17.07,
      "end": 19.81,
      "text": "هنرهای ایران توی بازارهای جهانی بوده."
    },
    {
      "start": 20.36,
      "end": 21.61,
      "text": "اسم «فرش ایرانی»"
    },
    {
      "start": 21.85,
      "end": 25.82,
      "text": "کم‌کم به نشونه‌ای از هنر، ظرافت و مهارت تبدیل شد."
    },
    {
      "start": 26.62,
      "end": 29.49,
      "text": "اما وقتی یه هنر این‌قدر معروف می‌شه،"
    },
    {
      "start": 29.73,
      "end": 31.09,
      "text": "یه اتفاق دیگه هم می‌افته:"
    },
    {
      "start": 31.48,
      "end": 34.01,
      "text": "بقیه شروع می‌کنن به تولید طرح‌های مشابه."
    },
    {
      "start": 34.54,
      "end": 37.48,
      "text": "امروز ممکنه فرشی با طرح تبریز یا کاشان،"
    },
    {
      "start": 37.66,
      "end": 39.31,
      "text": "توی کشور دیگه‌ای بافته بشه"
    },
    {
      "start": 39.43,
      "end": 41.54,
      "text": "و با عنوان «سبک ایرانی» فروخته بشه."
    },
    {
      "start": 42.04,
      "end": 44.94,
      "text": "اینجا تفاوت «منشأ» و «طرح» مهم می‌شه؛"
    },
    {
      "start": 45.24,
      "end": 46.56,
      "text": "یکی منشأ تولیده،"
    },
    {
      "start": 46.73,
      "end": 47.39,
      "text": "یکی طرح."
    },
    {
      "start": 47.94,
      "end": 50.22,
      "text": "اما ماجرا پیچیده‌تر از این حرفاست."
    },
    {
      "start": 50.58,
      "end": 54.05,
      "text": "فرض کن یه بافندهٔ ایرانی، با نقشهٔ اصیل تبریز،"
    },
    {
      "start": 54.29,
      "end": 56.01,
      "text": "توی یه کشور دیگه فرش ببافه."
    },
    {
      "start": 56.46,
      "end": 58.59,
      "text": "حالا این فرش ایرانیه یا خارجی؟"
    },
    {
      "start": 59.01,
      "end": 60.92,
      "text": "اگه بگی محل تولید مهمه،"
    },
    {
      "start": 61.14,
      "end": 62.84,
      "text": "پس مهارت بافنده چی می‌شه؟"
    },
    {
      "start": 63.24,
      "end": 64.72,
      "text": "اگه بگی طرح مهمه،"
    },
    {
      "start": 64.9,
      "end": 66.97,
      "text": "پس هرکسی می‌تونه یه طرح ایرانی رو کپی کنه"
    },
    {
      "start": 66.97,
      "end": 69.03,
      "text": "و محصولش رو ایرانی بدونه؟"
    },
    {
      "start": 69.36,
      "end": 72.71,
      "text": "به نظرت اصالت یه فرش به جاییه که بافته شده،"
    },
    {
      "start": 72.87,
      "end": 74.36,
      "text": "به کسیه که بافتتش،"
    },
    {
      "start": 74.59,
      "end": 76.3,
      "text": "یا به تاریخی که پشت طرحشه؟"
    },
    {
      "start": 76.84,
      "end": 80.42,
      "text": "راستی، اگه دوست داری یه مجموعهٔ جذاب"
    },
    {
      "start": 80.42,
      "end": 83.3,
      "text": "از واژه‌ها و اصطلاحات انگلیسی"
    },
    {
      "start": 83.34,
      "end": 85.07,
      "text": "دربارهٔ هنرهای سنتی و صنایع‌دستی ایران رو،"
    },
    {
      "start": 85.28,
      "end": 87.27,
      "text": "همراه با داستان‌های تاریخی"
    },
    {
      "start": 87.27,
      "end": 89.06,
      "text": "و تمرین‌های کاربردی داشته باشی،"
    },
    {
      "start": 89.31,
      "end": 90.98,
      "text": "کلمهٔ «هنر» رو کامنت کن"
    },
    {
      "start": 91.01,
      "end": 91.91,
      "text": "تا برات بفرستیم."
    }
  ],
